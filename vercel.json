{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "HUSKY=0 npm ci",
  "buildCommand": "npm run build:web -w mobile",
  "outputDirectory": "mobile/dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "production": true
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
