# Ingredient image extraction provider. Defaults to Gemini.
# Supported values: gemini, claude
INGREDIENT_EXTRACTION_PROVIDER=gemini

# Recipe generation provider. Defaults to Gemini so the demo can run without
# Anthropic API credits. Set to "claude" only if ANTHROPIC_API_KEY is funded.
# Supported values: gemini, claude
RECIPE_GENERATION_PROVIDER=gemini

# Google Gemini API key — required for Gemini ingredient extraction and Gemini
# recipe generation.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# Optional Gemini model override for ingredient extraction.
# GEMINI_INGREDIENT_MODEL=gemini-2.5-flash

# Optional Gemini model override for recipe generation.
# GEMINI_RECIPE_MODEL=gemini-2.5-flash

# Anthropic API key — only required when RECIPE_GENERATION_PROVIDER=claude or
# INGREDIENT_EXTRACTION_PROVIDER=claude.
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Port the Express server listens on locally.
PORT=3001

# Optional override for the SQLite recipe cache path. Resolved against the
# server working directory; the parent directory is created on demand. Use
# ":memory:" for an ephemeral in-process database.
# RECIPE_DB_PATH=./data/recipes.db
