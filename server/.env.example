# Ingredient image extraction provider. Defaults to Gemini.
# Supported values: gemini, claude
INGREDIENT_EXTRACTION_PROVIDER=gemini

# Google Gemini API key — required when INGREDIENT_EXTRACTION_PROVIDER=gemini.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# Optional Gemini model override for ingredient extraction.
# GEMINI_INGREDIENT_MODEL=gemini-2.5-flash

# Anthropic API key — required for Claude recipe generation.
# Also required for image extraction when INGREDIENT_EXTRACTION_PROVIDER=claude.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Port the Express server listens on locally.
PORT=3001
