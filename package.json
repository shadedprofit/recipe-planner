{
  "name": "recipe-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Smart recipe planner: ingredient photos to 5 structured recipes via multimodal AI.",
  "workspaces": [
    "mobile",
    "server",
    "shared"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm test --workspaces --if-present -- --coverage",
    "demo": "docker compose --env-file server/.env up --build",
    "demo:server": "docker compose --env-file server/.env up --build server",
    "demo:down": "docker compose --env-file server/.env down --remove-orphans"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "ajv": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "react-server-dom-webpack": "^19.0.2",
    "schema-utils": {
      "ajv": "^8.17.1"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "merge-options": "^3.0.4"
  }
}
